{
  "name": "cmd-mod-cmux-notify",
  "version": "0.2.0",
  "description": "cmux notifications for Command Code: banners when a turn finishes or a permission prompt is waiting.",
  "keywords": [
    "cmd-mod",
    "cmd-mod-hook",
    "command-code",
    "cmux",
    "notifications",
    "macos",
    "permissions"
  ],
  "license": "MIT",
  "author": {
    "name": "Hashim Lokasher",
    "url": "https://github.com/Hashimlokasher"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hashimlokasher/cmd-mod-cmux-notify.git"
  },
  "homepage": "https://github.com/Hashimlokasher/cmd-mod-cmux-notify#readme",
  "bugs": {
    "url": "https://github.com/Hashimlokasher/cmd-mod-cmux-notify/issues"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "commandcode": {
    "mods": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "CMUX_INTEGRATION=1 node --test test/integration/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=93 --test-coverage-branches=90 --test-coverage-functions=95 test/unit/*.test.mjs",
    "test:live-host": "CMUX_INTEGRATION=1 CMUX_LIVE_HOST=1 node --test test/integration/live-host.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
